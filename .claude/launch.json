{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CORS_ORIGINS=http://localhost:8082",
        "backend/.venv/bin/uvicorn",
        "--app-dir",
        "backend",
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "mobile-web-local-backend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:8000",
        "npm",
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "mobile-web-test-backend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:8001",
        "npm",
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8082",
        "--localhost"
      ],
      "port": 8082
    }
  ]
}
