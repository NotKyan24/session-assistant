# Copy this file to .env (gitignored) and fill in HF_TOKEN. Never commit real values.

# Hugging Face read token, used only to load the pyannote speaker-labeling model.
HF_TOKEN=

# WhisperX settings: "small" model on the Mac's CPU, 8-bit math for speed.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Turn off pyannote's usage telemetry.
PYANNOTE_METRICS_ENABLED=0

# Where audio and session files live, relative to backend/.
DATA_DIR=../data

# 1 = use only already-downloaded models; never contact Hugging Face.
# Set to 0 for one run to download or update a model.
HF_HUB_OFFLINE=1
